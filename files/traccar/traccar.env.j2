# Сгенерировано Ansible из files/traccar/traccar.env.j2 (секреты — из vars/traccar.yml). 0600.
# Traccar берёт параметры конфигурации из переменных окружения: database.password → DATABASE_PASSWORD,
# openid.clientSecret → OPENID_CLIENT_SECRET. Значение отсюда важнее значения в traccar.xml.
# Символ $ удваивается: docker compose подставляет переменные и в env_file.
CONFIG_USE_ENVIRONMENT_VARIABLES=true
TZ={{ traccar_tz }}

DATABASE_PASSWORD={{ traccar_db_password | string | replace('$', '$$') }}
OPENID_CLIENT_SECRET={{ traccar_openid_client_secret | string | replace('$', '$$') }}
GEOCODER_KEY={{ traccar_geocoder_key | string | replace('$', '$$') }}
GEOLOCATION_KEY={{ traccar_geolocation_key | string | replace('$', '$$') }}
MAIL_SMTP_PASSWORD={{ traccar_smtp_password | string | replace('$', '$$') }}
NOTIFICATOR_TRACCAR_KEY={{ traccar_push_key | string | replace('$', '$$') }}
NOTIFICATOR_TELEGRAM_KEY={{ telegram_bot_token | string | replace('$', '$$') }}
